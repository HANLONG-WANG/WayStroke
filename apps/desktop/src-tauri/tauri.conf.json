{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WayStroke", "version": "0.1.0", "identifier": "io.github.waystroke.Desktop",
  "build": { "beforeDevCommand": "npm run web:dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run web:build", "frontendDist": "../dist" },
  "app": { "enableGTKAppId": true, "windows": [{ "label": "main", "title": "WayStroke", "width": 1280, "height": 820, "minWidth": 1000, "minHeight": 600, "decorations": false, "transparent": true, "resizable": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}
