<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WayStroke</vendor>
  <action id="io.github.waystroke.configure-input">
    <description>Authorize WayStroke mouse service</description>
    <description xml:lang="zh_CN">授权 WayStroke 鼠标服务</description>
    <message>Administrator authentication is required to authorize the mouse service for this desktop user.</message>
    <message xml:lang="zh_CN">需要管理员认证，以授权当前桌面用户使用鼠标服务。</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/waystroke/authorize-input</annotate>
  </action>
</policyconfig>
