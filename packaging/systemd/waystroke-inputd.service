[Unit]
Description=WayStroke authorized mouse input service
After=systemd-udevd.service
Conflicts=waystroke-input-probe.service
ConditionPathExists=/etc/waystroke/inputd.conf

[Service]
Type=simple
EnvironmentFile=/etc/waystroke/inputd.conf
ExecStart=/usr/bin/waystroke-inputd --uid ${WAYSTROKE_INPUT_UID}
Restart=on-failure
RuntimeDirectory=waystroke
RuntimeDirectoryMode=0711
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/waystroke

[Install]
WantedBy=multi-user.target
